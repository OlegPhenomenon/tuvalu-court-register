# Copy to .env and adjust. No secrets are needed for the demo.
# demo        = public showcase: isolated sandbox per visitor, persona switcher, fictional data
# production  = single court database, password + TOTP sign-in
TCR_MODE=demo
TCR_DATA_DIR=/data
TCR_BIND=0.0.0.0:8088
# Set to true when served over HTTPS (it always should be outside localhost).
TCR_COOKIE_SECURE=true
TCR_SESSION_HOURS=12
TCR_UPLOAD_MAX_MB=15
# Demo-only limits (ignored in production)
TCR_SANDBOX_TTL_HOURS=72
TCR_MAX_SANDBOXES=200
TCR_SANDBOX_QUOTA_MB=25
RUST_LOG=info

# Demo always uses format checks only and the local mailbox, even when SMTP is set.
# In production, configure clamd OR explicitly choose TCR_AV=off.
TCR_AV=off
# TCR_CLAMD=tcp://127.0.0.1:3310
# TCR_CLAMD=unix:/run/clamav/clamd.ctl
TCR_SCAN_TIMEOUT_MS=10000
# Production SMTP (credentials are secrets; URL-encode them).
# smtp:// requires STARTTLS; smtps:// uses implicit TLS. No TLS query overrides.
# TCR_SMTP_URL=smtp://user:password@smtp.example.invalid:587
# TCR_MAIL_FROM=DEMO Registry <registry@example.invalid>
TCR_SMTP_TIMEOUT_SECS=20
# Maintenance and server can load the same literal env file.
# TCR_ENV_FILE=/etc/tuvalu-court.env
